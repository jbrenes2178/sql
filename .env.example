# Copia a `.env` (nunca se commitea). Sin secretos reales en este archivo.

# --- Aplicación ---
DATABASE_URL=postgresql://optica:optica@localhost:5432/optica?schema=public
APP_URL=http://localhost:3000
APP_ENV=development
TZ=America/Costa_Rica
DEFAULT_CURRENCY=CRC
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
BETTER_AUTH_URL=http://localhost:3000
AUTH_SECRET=replace-with-at-least-32-random-characters

# Seed de desarrollo (obligatorio para `npm run db:seed`)
SEED_ADMIN_EMAIL=admin@optica-cr.local
SEED_ADMIN_PASSWORD=replace-with-a-strong-dev-password

# Base de pruebas de integración (PostgreSQL real, no SQLite)
TEST_DATABASE_URL=postgresql://optica:optica@localhost:5432/optica_test?schema=public

# Solo para forzar seed en producción (no usar salvo recuperación controlada)
# ALLOW_PRODUCTION_SEED=

# --- Jobs ---
LOG_LEVEL=info

# --- Hacienda (no usadas en Fase 1; sandbox por defecto) ---
HACIENDA_ENVIRONMENT=sandbox
HACIENDA_RECEPCION_SANDBOX_URL=https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/
HACIENDA_RECEPCION_PRODUCTION_URL=https://api.comprobanteselectronicos.go.cr/recepcion/v1/
HACIENDA_IDP_URL=https://idp.comprobanteselectronicos.go.cr/auth
HACIENDA_IDP_TOKEN_URL=
HACIENDA_CLIENT_ID=
HACIENDA_USERNAME=
HACIENDA_PASSWORD=
HACIENDA_CERTIFICATE_PATH=
HACIENDA_CERTIFICATE_PASSWORD=
HACIENDA_PUBLIC_API_BASE_URL=https://api.hacienda.go.cr

WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_PATH=./var/storage
