# Copia este archivo a .env y completa valores reales fuera del repositorio.
# Nunca commitees secretos. Nunca expongas estas variables al navegador.

# --- Aplicación ---
DATABASE_URL=postgresql://optica:optica@localhost:5432/optica?schema=public
APP_URL=http://localhost:3000
APP_ENV=development
TZ=America/Costa_Rica
DEFAULT_CURRENCY=CRC
AUTH_SECRET=replace-with-long-random-secret

# --- Hacienda: nunca default production ---
HACIENDA_ENVIRONMENT=sandbox

# URLs oficiales documentadas en Anexos y Estructuras v4.4, Anexo 3
# https://atv.hacienda.go.cr/ATV/ComprobanteElectronico/docs/esquemas/2024/v4.4/ANEXOS%20Y%20ESTRUCTURAS_V4.4.pdf
HACIENDA_RECEPCION_SANDBOX_URL=https://api.comprobanteselectronicos.go.cr/recepcion-sandbox/v1/
HACIENDA_RECEPCION_PRODUCTION_URL=https://api.comprobanteselectronicos.go.cr/recepcion/v1/
HACIENDA_IDP_URL=https://idp.comprobanteselectronicos.go.cr/auth

# Token endpoint de PRODUCCIÓN según Anexo 3. El endpoint de sandbox
# debe tomarse de la documentación oficial de credenciales de pruebas
# (ATV / Tico Factura) y verificarse antes de usarlo. No asumir realm/client.
HACIENDA_IDP_TOKEN_URL=
HACIENDA_CLIENT_ID=

HACIENDA_USERNAME=
HACIENDA_PASSWORD=

HACIENDA_CERTIFICATE_PATH=
HACIENDA_CERTIFICATE_PASSWORD=

# APIs públicas oficiales: https://api.hacienda.go.cr/docs/
HACIENDA_PUBLIC_API_BASE_URL=https://api.hacienda.go.cr

# --- WhatsApp Business Platform (oficial Meta) ---
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_SECRET=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Correo ---
EMAIL_PROVIDER=smtp
EMAIL_FROM=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- Almacenamiento de archivos fiscales y adjuntos ---
FILE_STORAGE_DRIVER=local
FILE_STORAGE_LOCAL_PATH=./var/storage
# FILE_STORAGE_S3_BUCKET=
# FILE_STORAGE_S3_REGION=
# FILE_STORAGE_S3_ENDPOINT=

# --- Observabilidad ---
LOG_LEVEL=info
